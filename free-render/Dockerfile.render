FROM eclipse-temurin:17-jdk-alpine AS build
WORKDIR /build
COPY free-render/UrlShortenerServer.java .
RUN javac UrlShortenerServer.java

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=build /build/*.class ./
COPY ["Link-Shortner front/index.html", "public/index.html"]
COPY ["Link-Shortner front/style.css", "public/style.css"]
COPY ["Link-Shortner front/app.js", "public/app.js"]
ENV STATIC_DIR=/app/public
EXPOSE 8080
CMD ["sh", "-c", "java UrlShortenerServer"]
